{
  "name": "clawtao",
  "version": "0.0.1",
  "description": "Desktop AI agent powered by Electron + Rust",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "core:build": "cd core && cargo build --release",
    "build": "pnpm run core:build && pnpm run build:vite && electron-builder",
    "build:vite": "tsc && vite build",
    "postinstall": "npx playwright install chromium",
    "test:all": "pnpm run test:ui && pnpm run test:core",
    "test:ui": "vitest run",
    "test:core": "cd core && cargo test"
  },
  "keywords": [
    "electron",
    "rust",
    "ai",
    "agent",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "playwright"
    ]
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "42.4.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  }
}
